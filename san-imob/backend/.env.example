# Copie para .env e preencha com valores reais. Nunca commitar o .env real.

# String de conexão do PostgreSQL (Supabase ou instância própria)
DATABASE_URL=postgresql://usuario:senha@host:5432/soma_imob

# Chave da API da Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Taxa de câmbio USD/BRL usada nos cálculos de custo do harness/logger.py
# (a tabela de preços já está em BRL, então isso só é usado se algum
# módulo futuro precisar converter preços cotados em USD)
USD_BRL_RATE=5.30
